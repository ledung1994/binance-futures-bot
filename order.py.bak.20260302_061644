#!/usr/bin/env python3
import os
import math
import logging
from binance.client import Client
from utils import log_trade

log = logging.getLogger("order")

_client = None
_symbol_info_cache = {}

def get_client():
    global _client
    if _client is None:
        api_key = os.environ.get("BINANCE_API_KEY", "")
        api_secret = os.environ.get("BINANCE_API_SECRET", "")
        use_testnet = os.environ.get("BINANCE_USE_TESTNET", "false").lower() == "true"
        if not api_key or not api_secret:
            raise ValueError("Missing BINANCE_API_KEY / BINANCE_API_SECRET")
        _client = Client(api_key, api_secret, testnet=use_testnet)
        log.info("Binance client initialized. Testnet=%s", use_testnet)
    return _client

def get_symbol_info(client, symbol):
    if symbol in _symbol_info_cache:
        return _symbol_info_cache[symbol]

    info = client.futures_exchange_info()
    for s in info.get("symbols", []):
        if s.get("symbol") != symbol:
            continue

        step_size = None
        min_qty = None
        max_qty = None

        for f in s.get("filters", []):
            if f.get("filterType") == "LOT_SIZE":
                step_size = float(f.get("stepSize", "0.001"))
                min_qty = float(f.get("minQty", "0.001"))
                max_qty = float(f.get("maxQty", "1e18"))

        data = {
            "quantityPrecision": int(s.get("quantityPrecision", 3)),
            "pricePrecision": int(s.get("pricePrecision", 2)),
            "step_size": step_size or 0.001,
            "min_qty": min_qty or 0.001,
            "max_qty": max_qty or 1e18,
        }
        _symbol_info_cache[symbol] = data
        return data

    # fallback
    data = {"quantityPrecision": 3, "pricePrecision": 2, "step_size": 0.001, "min_qty": 0.001, "max_qty": 1e18}
    _symbol_info_cache[symbol] = data
    return data

def _floor_to_step(qty, step):
    if step <= 0:
        return qty
    return math.floor(qty / step) * step

def format_quantity(quantity, symbol_info):
    step = float(symbol_info.get("step_size", 0.001))
    min_qty = float(symbol_info.get("min_qty", 0.001))
    max_qty = float(symbol_info.get("max_qty", 1e18))

    q = float(quantity)
    q = _floor_to_step(q, step)
    # làm tròn theo precision để tránh 0.30000000004
    prec = int(symbol_info.get("quantityPrecision", 3))
    q = float(f"{q:.{prec}f}")

    if q < min_qty:
        return 0.0
    if q > max_qty:
        q = max_qty
        q = _floor_to_step(q, step)
        q = float(f"{q:.{prec}f}")
    return q

def get_mark_price(client, symbol):
    # futures_mark_price trả dict có markPrice
    mp = client.futures_mark_price(symbol=symbol)
    return float(mp.get("markPrice", 0.0))

def place_market_order(symbol, side, quantity, min_notional_usdt=5.0):
    """
    side: "BUY" or "SELL"
    quantity: base asset qty (vd BTC qty)
    """
    client = get_client()
    info = get_symbol_info(client, symbol)

    qty = format_quantity(quantity, info)
    if qty <= 0:
        log.warning("Calculated qty too small for %s (min_qty=%s). Skip.", symbol, info.get("min_qty"))
        return None

    # check min notional (lỗi -4164: notional < 5)
    price = get_mark_price(client, symbol)
    notional = qty * price
    if price <= 0:
        log.warning("Mark price unavailable for %s. Skip.", symbol)
        return None
    if notional < float(min_notional_usdt):
        log.warning("Notional too small for %s: %.4f < %.2f. Skip.", symbol, notional, min_notional_usdt)
        return None

    try:
        order = client.futures_create_order(
            symbol=symbol,
            side=side,
            type="MARKET",
            quantity=str(qty),
            newOrderRespType="FULL",
        )
        log.info("MARKET ORDER placed: %s %s qty=%s avgPrice=%s status=%s orderId=%s",
                 side, symbol, qty, order.get("avgPrice"), order.get("status"), order.get("orderId"))

        # lưu log trade nhẹ
        trade_data = {
            "symbol": symbol,
            "side": side,
            "quantity": qty,
            "entry_price": float(order.get("avgPrice") or 0.0),
            "status": order.get("status"),
            "orderId": order.get("orderId"),
        }
        try:
            log_trade(trade_data)
        except Exception:
            log.exception("log_trade failed (non-fatal)")

        return order

    except Exception as e:
        log.exception("Failed to place market order %s %s qty=%s: %s", side, symbol, qty, e)
        return None
